        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"id\" TEXT NOT NULL, \"merchant\" TEXT NOT NULL, \"expense_date\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL, \"total_cents\" INTEGER NOT NULL, \"paid_by_participant_id\" TEXT NOT NULL REFERENCES participants (id) ON DELETE RESTRICT, \"receipt_local_path\" TEXT NOT NULL, \"raw_ocr_text\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (currency = 'EUR'), CHECK (total_cents > 0));"
